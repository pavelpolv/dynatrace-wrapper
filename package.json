{
  "name": "farzoom-metrics-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "test:e2e": "turbo run test --filter=@farzoom/e2e",
    "test:e2e:headed": "turbo run test:headed --filter=@farzoom/e2e",
    "test:e2e:ui": "turbo run test:ui --filter=@farzoom/e2e",
    "test:e2e:debug": "turbo run test:debug --filter=@farzoom/e2e",
    "test:e2e:report": "turbo run report --filter=@farzoom/e2e"
  },
  "devDependencies": {
    "rimraf": "^6.1.2",
    "turbo": "^2.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@types/react": "17.0.62",
    "@types/react-dom": "17.0.20"
  }
}
