{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test": {
      "cache": false,
      "outputs": ["test-results/**", "playwright-report/**"]
    },
    "test:headed": {
      "cache": false
    },
    "test:ui": {
      "cache": false
    },
    "test:debug": {
      "cache": false
    },
    "report": {
      "cache": false
    }
  }
}
